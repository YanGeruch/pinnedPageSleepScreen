# Standalone mod — PURE MOD SPACE. Installs one qmd under /home/root/xovi/ and
# nothing else: no assets, no xovi extensions, no install hooks, no system
# folders. The mod DOES write to /etc at runtime (the timezone symlink and a
# xochitl.service.d drop-in), but only on an explicit user tap in Settings and
# only through CommandExecutor — so `vellum del` needs nothing to revert: /etc
# is a RAM-backed overlay and the writes die at the next reboot, at which point
# no re-assert exists to replay them.
pkgname=timezone-locale-picker
pkgver=0.1.0
pkgrel=0
pkgdesc="Time zone and locale picker in Settings > Display; the stock UI has neither"
url="https://github.com/YanGeruch/pinnedPageSleepScreen"
arch="aarch64"
license="GPL-3.0-or-later"
# qt-command-executor: the timezone and locale commands run as transient
# systemd units. remarkable-os range: the qmd's hashes are built against 3.27
# QML. rmppmove: the only device the Display panel has been checked on.
depends="qt-resource-rebuilder qt-command-executor rmppmove
	remarkable-os>=3.27 remarkable-os<3.28"
options="!check"

package() {
	install -Dm644 "$srcdir"/timezoneLocalePicker.qmd \
		"$pkgdir"/home/root/xovi/exthome/qt-resource-rebuilder/timezoneLocalePicker.qmd
}
