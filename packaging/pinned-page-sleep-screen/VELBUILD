# Main mod — PURE MOD SPACE. Installs only under /home/root/xovi/:
# the qmd (qt-resource-rebuilder), the wallpaper SVG, and the bundled
# fastshot xovi extension (synchronous ~70ms framebuffer captures; source
# in extensions/fastshot/). No system folders touched — reviewable without
# system-modification caution. The sleep-clock companion package
# (pinned-sleep-clock) carries everything that touches the system.
pkgname=pinned-page-sleep-screen
pkgver=0.40.0
pkgrel=0
pkgdesc="Pin a document page — or the live screen — as the sleep screen; optional clock/battery bar"
url="https://github.com/YanGeruch/pinnedPageSleepScreen"
arch="aarch64"
license="GPL-3.0-or-later"
# remarkable-os range: the qmd's hashes are built against 3.27 QML.
# rmppmove: fastshot.so is built and tested for the Paper Pro Move only.
# (Verified on-device 2026-08-19: rmppmove-1.0.0-r0 is the real virtual
# package and PROVIDES rmppm — the doc-derived claim that only rmppm exists
# was backwards.) !mini-light-sleep: both 3.27 variants remove the same
# ArkControls.ActionBar node this mod removes — the pair cannot compose
# (exact ecosystem name mini-light-sleep-1.0.5-r3, confirmed via apk search).
depends="!mini-light-sleep
	qt-resource-rebuilder xovi-message-broker qt-command-executor
	framebuffer-spy rm-shot rmppmove
	remarkable-os>=3.27 remarkable-os<3.28"
options="!check"

package() {
	install -Dm644 "$srcdir"/pinnedPageSleepScreen.qmd \
		"$pkgdir"/home/root/xovi/exthome/qt-resource-rebuilder/pinnedPageSleepScreen.qmd
	install -Dm644 "$srcdir"/pinnedSleepScreen.svg \
		"$pkgdir"/home/root/xovi/exthome/qt-resource-rebuilder/pinnedSleepScreen.svg
	# both bolt variants: the black bar style selects pinnedSleepBoltInv.svg
	install -Dm644 "$srcdir"/pinnedSleepBolt.svg \
		"$pkgdir"/home/root/xovi/exthome/qt-resource-rebuilder/pinnedSleepBolt.svg
	install -Dm644 "$srcdir"/pinnedSleepBoltInv.svg \
		"$pkgdir"/home/root/xovi/exthome/qt-resource-rebuilder/pinnedSleepBoltInv.svg
	install -Dm755 "$srcdir"/fastshot.so \
		"$pkgdir"/home/root/xovi/extensions.d/fastshot.so
}
